{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/projects.js": {
      "includeFiles": "shared/**"
    },
    "api/about.js": {
      "includeFiles": "shared/**"
    },
    "api/strategy-call.js": {
      "includeFiles": "shared/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/projects",
      "destination": "/api/projects.js"
    },
    {
      "source": "/api/projects/featured",
      "destination": "/api/projects.js"
    },
    {
      "source": "/api/about",
      "destination": "/api/about.js"
    },
    {
      "source": "/api/strategy-call",
      "destination": "/api/strategy-call.js"
    },
    {
      "source": "/api/scorecard-results",
      "destination": "/api/scorecard-results.js"
    },
    {
      "source": "/approach",
      "destination": "/approach.html"
    },
    {
      "source": "/packages",
      "destination": "/packages.html"
    },
    {
      "source": "/platforms",
      "destination": "/platforms.html"
    },
    {
      "source": "/book",
      "destination": "/book.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/scorecard",
      "destination": "/scorecard.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
