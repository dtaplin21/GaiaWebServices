# Stripe Payment Integration
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Strategy call email delivery
# Create the API key in SendGrid: Settings → API Keys → Create API Key (Mail Send permission).
# SENDGRID_FROM_EMAIL must be a verified Single Sender or authenticated domain in SendGrid.
# CONTACT_EMAIL is the inbox that receives consultation requests.
# Put the real values in .env locally, and in the host's environment settings for production.
# Do not commit the real API key.
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=dtaplin21@gmail.com
CONTACT_EMAIL=dtaplin21@gmail.com

# Optional: Server Configuration (defaults are already set)
# PORT=5001
# NODE_ENV=development
